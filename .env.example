# GitHub fine-grained token with read-only access to public repositories.
GITHUB_TOKEN=
# HTTPS API hosts allowed to receive the read-only token, separated by semicolons.
GITHUB_ALLOWED_HOSTS=api.github.com
# Hosts allowed to receive the unauthenticated tarball follow-up. Never send GITHUB_TOKEN here.
GITHUB_ARCHIVE_HOSTS=codeload.github.com
GITHUB_MAX_RETRIES=3
GITHUB_RETRY_BASE_SECONDS=0.5
GITHUB_RETRY_MAX_SECONDS=60

DATABASE_URL=sqlite:///./data/contribos.db
ARTIFACT_ROOT=./data/artifacts
# Optional token required by mutation APIs. Keep it out of source control.
LOCAL_ACCESS_TOKEN=
APP_TIMEZONE=Asia/Shanghai
PREFERRED_LANGUAGES='Python;TypeScript'
STRATEGIC_KEYWORDS='agent;ai;cli;codex;dify;github;llm;mcp;openclaw;vllm'
CANDIDATES_PER_QUERY=25
DAILY_PICK_COUNT=10
REPOSITORY_CACHE_HOURS=24
REPOSITORY_INACTIVE_DAYS=365
MINIMUM_ISSUE_BODY_LENGTH=40

# none = rule-only fallback. fake = offline FakeProvider. nvidia_nim = NVIDIA Build via the internal gateway.
ANALYSIS_PROVIDER=none
ANALYSIS_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
# DeepSeek handles code-aware planning, multi-turn coding and ChangeSet proposals.
IMPLEMENTATION_PROVIDER=none
IMPLEMENTATION_MODEL=deepseek-ai/deepseek-v4-pro-0813
# MiniMax reviews the exact finalized diff and normalized test artifacts.
REVIEW_PROVIDER=none
REVIEW_MODEL=minimaxai/minimax-m3

# Only model-gateway may receive NVIDIA_API_KEY. Use 64+ random hex characters
# for the shared short-lived task-token signing key used by provider-worker and gateway.
NVIDIA_API_KEY=
# Optional: explicit credential-free CONNECT proxy for model-gateway only.
# Do not copy generic HTTP(S)_PROXY values automatically or put proxy credentials here.
NVIDIA_HTTPS_PROXY=
MODEL_GATEWAY_SIGNING_KEY=
# Separate 64+ random hex characters shared ONLY by API and model-gateway.
# Enables browser-encrypted credential settings; never reuse the task signing key.
MODEL_GATEWAY_MANAGEMENT_KEY=
# Gateway-only path. Compose uses the separate contribos-model-secrets volume.
MODEL_GATEWAY_SECRET_ROOT=/data/model-secrets
MODEL_GATEWAY_BASE_URL=http://contribos-model-gateway:8001/v1
MODEL_GATEWAY_NETWORK=contribos-model-gateway-local
MODEL_GATEWAY_SERVICE_NAME=contribos-model-gateway
# Optional HMAC key (64+ hex chars) so executions enqueue Explore Jobs.
# SANDBOX_JOB_SPEC_KEY_ID=local-v1
# SANDBOX_JOB_SPEC_SIGNING_KEY=
# none = fail closed. fake = offline stages. docker = dedicated sandbox-worker only.
SANDBOX_STAGE_RUNTIME=none

# Separate queries with semicolons. Leave unset to use the built-in defaults.
# GITHUB_QUERIES='is:issue is:open no:assignee label:"help wanted" language:Python;is:issue is:open no:assignee bounty in:title,body'
# AI planning and automatic execution require the digest-pinned Sandbox Runner.
# WORKBENCH_RUNNER_IMAGE=sha256:<docker-image-id>
# Enable the dedicated Docker supervisor with the NVIDIA services:
# COMPOSE_PROFILES=nvidia,sandbox
# Exact output of: docker volume inspect contribos-local-data --format '{{.Mountpoint}}'
# SANDBOX_DATA_ROOT=/var/lib/docker/volumes/contribos-local-data/_data
# Daemon-side Docker socket path and its group ID (OrbStack defaults below).
# SANDBOX_DOCKER_SOCKET=/var/run/docker.sock
# SANDBOX_DOCKER_GID=0
# Explicit publication mode: none (default), fake (offline demonstration), gh.
# PUBLISHER_MODE=none
# Absolute, dedicated gh configuration directory for the optional Publisher container.
# Never mount the entire HOME or reuse the discovery token here.
# PUBLISHER_GH_CONFIG_DIR=/absolute/path/to/dedicated-publisher-auth
