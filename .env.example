# GitHub fine-grained token with read-only access to public repositories.
GITHUB_TOKEN=
# HTTPS API hosts allowed to receive the read-only token, separated by semicolons.
GITHUB_ALLOWED_HOSTS=api.github.com
# Hosts allowed to receive the unauthenticated tarball follow-up. Never send GITHUB_TOKEN here.
GITHUB_ARCHIVE_HOSTS=codeload.github.com
GITHUB_MAX_RETRIES=3
GITHUB_RETRY_BASE_SECONDS=0.5
GITHUB_RETRY_MAX_SECONDS=60

DATABASE_URL=sqlite:///./data/contribos.db
ARTIFACT_ROOT=./data/artifacts
# Optional token required by mutation APIs. Keep it out of source control.
LOCAL_ACCESS_TOKEN=
APP_TIMEZONE=Asia/Shanghai
PREFERRED_LANGUAGES='Python;TypeScript'
STRATEGIC_KEYWORDS='agent;ai;cli;codex;dify;github;llm;mcp;openclaw;vllm'
CANDIDATES_PER_QUERY=25
DAILY_PICK_COUNT=10
REPOSITORY_CACHE_HOURS=24
REPOSITORY_INACTIVE_DAYS=365
MINIMUM_ISSUE_BODY_LENGTH=40

# none = rule-only fallback. fake = offline FakeProvider. codex is not wired.
ANALYSIS_PROVIDER=none
# Optional HMAC key (64+ hex chars) so executions enqueue Explore Jobs.
# SANDBOX_JOB_SPEC_KEY_ID=local-v1
# SANDBOX_JOB_SPEC_SIGNING_KEY=
# none = fail closed without a stage runtime. fake = offline Explore/Implement/Verify.
SANDBOX_STAGE_RUNTIME=none

# Separate queries with semicolons. Leave unset to use the built-in defaults.
# GITHUB_QUERIES='is:issue is:open no:assignee label:"help wanted" language:Python;is:issue is:open no:assignee bounty in:title,body'
