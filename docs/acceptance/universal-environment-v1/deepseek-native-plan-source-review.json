  "findings": [
    {
      "code": "stable_call_id_not_propagated_by_event_producers",
      "severity": "blocking",
      "facts": "ToolResultBlock.tool_use_id is a transcript field, not proof of a web event payload field. Frozen TranscriptParser start/end and HookServer start/end/failure emit payloads omit the stable call identifier. The Plan limits writes to four web files and explicitly defers checking upstream propagation.",
      "impact": "Generating a new local ID at start cannot reliably match a later out-of-order completion when neither event carries their shared call ID. The saved web-only plan does not establish the claimed end-to-end identity contract.",
      "remediation": "Have the native planner inspect event producers and prepare a child Plan with all necessary producer/consumer paths and regressions. Preserve the four CI commands and require fresh exact execution approval."
    }
  ],
