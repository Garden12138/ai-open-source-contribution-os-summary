@@ -0,0 +1,33 @@
+"""Measured tool compatibility constraints, never repository-name exceptions."""
+from __future__ import annotations
+
+from packaging.requirements import Requirement
+from app.environment_engine.source import ResolutionError
+
+READONLY_STUBTEST_PROFILE = {
+    "version": "python-readonly-tools-v1",
+    "source": "platform_capability_registry",
+    "tool": "stubtest",
+    "distribution": "mypy",
+    "constraints": ["mypy==1.15.0"],
+    "reason_code": "readonly_toolchain_compatibility",
+}
+
+
+def readonly_tool_profile(declarations: list, commands: list[dict]) -> dict | None:
+    """Choose a measured candidate only within the project's declarations.
+
+    This is not preparation/baseline proof. Actual RECORD, ABI and all commands
+    must still pass. Never relax a project's explicit version constraint.
+    """
+    if not any(c["argv"][0] == "stubtest" or c["argv"][:3] in (
+            ["python", "-m", "mypy.stubtest"], ["python3", "-m", "mypy.stubtest"]) for c in commands):
+        return None
+    selected = [d for d in declarations if d.distribution == "mypy"]
+    if not selected or not any(not d.constraint for d in selected):
+        return None
+    for declaration in selected:
+        requirement = Requirement(declaration.requirement)
+        if requirement.marker or not requirement.specifier.contains("1.15.0"):
+            raise ResolutionError("tool_version_not_supported", tuple(d.source.path for d in selected))
+    return {**READONLY_STUBTEST_PROFILE, "constraints": list(READONLY_STUBTEST_PROFILE["constraints"])}
