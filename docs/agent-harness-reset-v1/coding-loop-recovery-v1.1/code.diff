+def unseen(ranges: list[list[int]], covered: list[list[int]]) -> list[list[int]]:
+    result = []
+    for start, end in merge(ranges):
+        for lo, hi in merge(covered):
+            if hi <= start or lo >= end:
+                continue
+            if lo > start:
+                result.append([start, lo])
+            start = max(start, hi)
+            if start >= end:
+                break
+        if start < end:
+            result.append([start, end])
+    return result
