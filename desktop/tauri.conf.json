{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ContribOS",
  "version": "2.0.0",
  "identifier": "com.contribos.desktop",
  "app": {
    "windows": [],
    "withGlobalTauri": false,
    "security": {
      "capabilities": [],
      "csp": "default-src 'none'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "macOS": {
      "signingIdentity": "-",
      "hardenedRuntime": false
    },
    "icon": ["icons/icon.png"],
    "externalBin": ["binaries/contribos-backend"]
  }
}
